package {
    default_applicable_licenses: ["system_lfi_license"],
}

cc_library_static {
    name: "libboxrt_minimal",
    defaults: ["system_lfi_defaults"],
    srcs: [
        "boxrt_minimal.c",
    ],
    whole_static_libs: ["librelocator"],
    visibility: [
        "//external/libopus:__subpackages__",
        "//build/soong:__subpackages__",
    ],
}
